{
  "name": "luai",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:flow-packs": "node scripts/install-flow-pack-packages.mjs && node scripts/build-flow-pack-registry.mjs",
    "build:flow-packs:public": "FLOW_PACK_VISIBILITY=public node scripts/install-flow-pack-packages.mjs && FLOW_PACK_VISIBILITY=public node scripts/build-flow-pack-registry.mjs",
    "docs:api": "typedoc --options typedoc.json",
    "docs:build": "npm run docs:api",
    "build:landing-pages": "node scripts/build-landing-pages.mjs",
    "dev": "node scripts/run-dev.mjs",
    "dev:private-packs": "FLOW_PACKS_DIRS=flow-packs,my-flow-packs,private-packages node scripts/run-dev.mjs",
    "dev:noauth": "node scripts/run-dev.mjs --noauth",
    "dev:noauth:private-packs": "FLOW_PACKS_DIRS=flow-packs,my-flow-packs,private-packages node scripts/run-dev.mjs --noauth",
    "dev:e2e": "node scripts/run-e2e-runtime.mjs",
    "build": "npm run build:flow-packs && next build",
    "build:public": "npm run build:flow-packs:public && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:public": "FLOW_PACK_VISIBILITY=public vitest run",
    "test:e2e": "playwright test",
    "test:parallel": "VITEST_MAX_WORKERS=100% vitest run",
    "test:verbose": "TEST_SHOW_CONSOLE=1 vitest run",
    "test:watch": "vitest",
    "test:coverage": "VITEST_COVERAGE_SCOPE=core vitest run --coverage",
    "test:coverage:all": "VITEST_COVERAGE_SCOPE=all vitest run --coverage",
    "test:coverage:core": "VITEST_COVERAGE_SCOPE=core vitest run --coverage",
    "test:coverage:public": "FLOW_PACK_VISIBILITY=public VITEST_COVERAGE_SCOPE=core vitest run --coverage",
    "test:coverage:packs": "VITEST_COVERAGE_SCOPE=packs vitest run --coverage",
    "test:coverage:parallel": "VITEST_COVERAGE_SCOPE=core VITEST_MAX_WORKERS=100% vitest run --coverage",
    "test:coverage:verbose": "VITEST_COVERAGE_SCOPE=core TEST_SHOW_CONSOLE=1 vitest run --coverage",
    "seed:flow-prompts": "node scripts/seed-flow-card-prompts.mjs",
    "container:stop": "make stop",
    "container:build": "make build",
    "container:destroy": "make clean",
    "container:relaunch": "make restart"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.47",
    "@ai-sdk/google": "^3.0.31",
    "@ai-sdk/openai": "^3.0.33",
    "@ai-sdk/react": "^1.1.20",
    "@clerk/nextjs": "^7.0.1",
    "@libsql/client": "^0.17.0",
    "@tanstack/react-query": "^5.90.21",
    "ai": "^6.0.100",
    "axios": "^1.13.5",
    "better-sqlite3": "^12.6.2",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
