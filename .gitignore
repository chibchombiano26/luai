env

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/coverage-*
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/html
/quotes.db
/test_output.txt
/ops/node-red/runtime-data
/.docker-local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
/docker.env
/docker.runtime.env
/.runtime-config/*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mcp-server
/src/mcp-server/node_modules
/src/mcp-server/dist

# clerk configuration (can include secrets)
/.clerk/

# private flow packs
/my-flow-packs/*
!/my-flow-packs/customer-support/
!/my-flow-packs/customer-support/**
/private-packages/
/data/
/.local/

# generated flow-pack registry and mounts
/src/lib/platform/generated-flow-pack-server.ts
/src/lib/platform/generated-flow-pack-ui.tsx
/src/lib/platform/generated-flow-packs.ts
/src/mcp-server/generated-flow-pack-mcp.ts
/src/app/(generated-flow-packs)/
