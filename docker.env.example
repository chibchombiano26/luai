# Copy to `docker.env` before running `docker compose`.

TZ=America/Bogota
MCP_PORT=604
MCP_PUBLIC_PORT=6604
START_MCP_SERVER=true
POSTGRES_PORT=5432
POSTGRES_DB=luai
POSTGRES_USER=luai
POSTGRES_PASSWORD=luai_dev_password
# Optional explicit override when credentials need URL encoding.
# POSTGRES_URL=postgresql://luai:luai_dev_password@postgres:5432/luai

# Pack sources
FLOW_PACKS_DIR=flow-packs
FLOW_PACK_PACKAGES=
PUBLIC_FLOW_PACK_PACKAGES=

# GitHub Packages auth for private packs during image build only.
# Do not place this token in `docker.runtime.env`.
NODE_AUTH_TOKEN=

# App public URL
NEXT_PUBLIC_APP_URL=http://localhost:6001
APP_URL_OVERRIDE=http://localhost:6001

# AI providers are expected to be configured from `/admin/ai-providers`.
# Environment variable fallback remains supported, but is intentionally omitted
# from the public example host configuration.
#
# Docker Compose now provisions a local PostgreSQL instance and wires
# `POSTGRES_URL` automatically from the values above.
# If your password contains URL-sensitive characters, set `POSTGRES_URL`
# explicitly in `docker.env`.
# `DATABASE_URL` remains mounted inside the containers as a SQLite fallback.

# Basic auth
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Debug
DEBUG_OUTBOUND_CURLS=false
DEBUG_OUTBOUND_HTTP_DETAILS=false
OUTBOUND_HTTP_DEBUG_MAX_BODY_CHARS=2000

# Put pack-specific runtime variables in `docker.runtime.env` if needed.
