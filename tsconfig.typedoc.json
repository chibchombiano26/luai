{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "next-env.d.ts",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/hooks/**/*.ts",
    "src/hooks/**/*.tsx",
    "src/app/api/chat/parser.ts",
    "src/app/api/chat/agent-tools-types.ts",
    "src/components/ThemeProvider.tsx"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/mcp-server/**/*",
    "flow-packs/**/*"
  ]
}
