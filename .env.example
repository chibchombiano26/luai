# Diagnostics
DEBUG_OUTBOUND_CURLS=false
DEBUG_OUTBOUND_HTTP_DETAILS=false
OUTBOUND_HTTP_DEBUG_MAX_BODY_CHARS=2000
# Optional: restrict external widget endpoints by host (comma-separated)
# WIDGET_ENDPOINT_ALLOWED_HOSTS=widgets.example.com,internal-widgets:8080

# AI providers are expected to be configured from `/admin/ai-providers`.
# Environment variable fallback remains supported, but is intentionally omitted
# from the public example host configuration.
#
# Database provider credentials are expected to be configured from
# `/admin/database-provider`. Environment variable fallback remains supported,
# but is intentionally omitted from the public example host configuration.

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:600

# Clerk auth (recommended for Google sign-in)
# Set both keys to enable Clerk middleware.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: set to false to force Basic Auth fallback even when Clerk keys exist.
CLERK_AUTH_ENABLED=true
# Local-only Clerk access bootstrap. Lets a signed-in developer bypass missing
# Clerk `publicMetadata.role` / group assignment while running `next dev`.
DEV_AUTH_ROLE=
DEV_AUTH_GROUP=

# Basic auth fallback (used when Clerk is disabled or keys are missing)
BASIC_AUTH_ENABLED=true
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change_this_in_vercel

# Additional pack-specific variables should be documented by the pack itself
# and set only in your private local `.env`.
